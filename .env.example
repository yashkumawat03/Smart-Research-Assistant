# Smart Research Assistant - Local Environment Variables
# Copy this file to .env and fill in your API key for local cloud provider testing

# Groq Cloud API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: OpenAI API Key (if using OpenAI cloud models)
OPENAI_API_KEY=sk_your_openai_api_key_here
